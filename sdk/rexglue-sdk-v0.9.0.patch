+                      double(now.QuadPart - window_start.QuadPart) / double(freq.QuadPart));
+                }
+              }
+            }
+          }
+          if (fs.PresentCount != last_present_count) {
+            last_present_count = fs.PresentCount;
+            last_refresh_count = fs.PresentRefreshCount;
+          }
+          if (double(now.QuadPart - window_start.QuadPart) >= 10.0 * double(freq.QuadPart)) {
