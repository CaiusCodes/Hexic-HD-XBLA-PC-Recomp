+void D3D12CommandProcessor::GpuTimeSubmissionBegin() {
+  const uint32_t slot = uint32_t(frame_current_ % kQueueFrames);
+  uint32_t& count = gpu_time_count_[slot];
+  if (!submission_open_ || count + 2 > kGpuTimeStampsPerFrame) {
+    return;
+  }
+  gpu_time_submission_begin_ = count++;
+  deferred_command_list_.D3DEndQuery(gpu_time_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     slot * kGpuTimeStampsPerFrame + gpu_time_submission_begin_);
+}
+
+void D3D12CommandProcessor::GpuTimeSubmissionEnd(bool is_closing_frame) {
+  const uint32_t slot = uint32_t(frame_current_ % kQueueFrames);
+  uint32_t& count = gpu_time_count_[slot];
+  if (gpu_time_submission_begin_ != UINT32_MAX) {
+    // Barriers queued so far belong to the work before this point.
+    SubmitBarriers();
+    deferred_command_list_.D3DEndQuery(gpu_time_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                       slot * kGpuTimeStampsPerFrame + count++);
+    gpu_time_submission_begin_ = UINT32_MAX;
+  }
+  if (is_closing_frame && gpu_time_heap_ && count) {
+    deferred_command_list_.D3DResolveQueryData(
+        gpu_time_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, slot * kGpuTimeStampsPerFrame, count,
+        gpu_time_readback_.Get(), slot * kGpuTimeStampsPerFrame * sizeof(uint64_t));
+    gpu_time_resolved_[slot] = true;
+  }
+}
