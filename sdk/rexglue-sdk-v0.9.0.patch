index 2d571e3..82da90f 100644
--- a/include/rex/ppc/context.h
+++ b/include/rex/ppc/context.h
@@ -196,6 +196,13 @@ struct FPSCRRegister {
 
   inline uint32_t loadFromHost() noexcept {
     csr = getcsr();
+    // Host FP exceptions must never actually trap: this recompiler does not
+    // deliver a guest-visible FP exception interrupt, so re-assert the mask
+    // in case something else running on this thread (a driver, a codec, an
+    // SIMD builder for a saturating conversion) touched MXCSR/FPCR without
+    // preserving it.
+    Platform::InitHostExceptions(csr);
+    setcsr(csr);
     return HostToGuest[(csr & RoundMaskVal) >> RoundShift];
   }
 
