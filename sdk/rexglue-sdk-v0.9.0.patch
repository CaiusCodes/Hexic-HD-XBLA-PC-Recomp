+// Binds a socket the guest never bound to 127.0.0.1 on an ephemeral port.
+// Without this, Windows binds it to every adapter the first time it listens,
+// sends or receives - which raises the same firewall prompt as an explicit
+// "any address" bind. Attempted once per socket; a failure (for example a
+// socket Windows already bound implicitly) is logged and not retried.
+void KeepUnboundSocketLocal(uint64_t handle, int af, bool& bound, uint16_t& bound_port,
+                            const char* reason) {
+  if (!REXCVAR_GET(net_loopback_only) || bound || af != AF_INET) {
+    return;
+  }
+  bound = true;
+  sockaddr_in local = {};
+  local.sin_family = AF_INET;
+  local.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  local.sin_port = 0;
+  if (bind(handle, reinterpret_cast<sockaddr*>(&local), sizeof(local)) != 0) {
+    REXLOG_INFO("[net] could not keep an unbound socket on 127.0.0.1 before {}", reason);
+    return;
+  }
+  socklen_t len = sizeof(local);
+  if (getsockname(handle, reinterpret_cast<sockaddr*>(&local), &len) == 0) {
+    bound_port = ntohs(local.sin_port);
+  }
+  REXLOG_INFO("[net] unbound socket kept on 127.0.0.1:{} before {} (net_loopback_only)",
+              bound_port, reason);
+}
