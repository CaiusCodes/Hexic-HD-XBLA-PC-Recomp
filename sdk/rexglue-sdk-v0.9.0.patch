+// XamUserCreateStatsEnumerator's results: one XUSER_STATS_READ_RESULTS,
+// laid out in the title's buffer by the first XamEnumerate.
+class XStatsEnumerator : public XEnumerator {
+ public:
+  XStatsEnumerator(KernelState* kernel_state, leaderboards::ResultSet results)
+      : XEnumerator(kernel_state, 1, results.size()), results_(std::move(results)) {}
+
+  uint32_t WriteItems(uint32_t buffer_ptr, uint8_t* buffer_data,
+                      uint32_t* written_count) override {
+    if (written_) {
+      return X_ERROR_NO_MORE_FILES;
+    }
+    results_.Write(buffer_data, buffer_ptr);
+    written_ = true;
+    if (written_count) {
+      *written_count = 1;
+    }
+    return X_ERROR_SUCCESS;
+  }
+
+ private:
+  leaderboards::ResultSet results_;
+  bool written_ = false;
+};
+
+}  // namespace
+
+// XUserCreateStatsEnumeratorBy{Xuid,Rank,Rating}, answered from the local
+// leaderboards (see local_leaderboards.h). type: 0 by XUID, 1 by rank, 2 by
+// rating; pivot is the XUID, starting rank or rating.
+u32 XamUserCreateStatsEnumerator_entry(u32 title_id, u32 type, u64 pivot, u32 num_rows,
+                                       u32 num_specs, u32 specs_ptr,
+                                       mapped_u32 buffer_size_ptr, mapped_u32 handle_ptr) {
+  if (!num_specs || !specs_ptr || !handle_ptr) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+
+  auto specs = leaderboards::ReadSpecs(
+      REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(specs_ptr), num_specs);
+  auto results = leaderboards::QueryEnumerator(
+      specs, static_cast<leaderboards::EnumerateBy>(uint32_t(type)), uint64_t(pivot),
+      uint32_t(num_rows));
+  if (buffer_size_ptr) {
+    *buffer_size_ptr = results.size();
+  }
+
+  auto e = object_ref<XStatsEnumerator>(
+      new XStatsEnumerator(REX_KERNEL_STATE(), std::move(results)));
+  auto result = e->Initialize(0, 0xFB, 0, 0, 0);
+  if (XFAILED(result)) {
+    return result;
+  }
+  *handle_ptr = e->handle();
+  return X_ERROR_SUCCESS;
+}
