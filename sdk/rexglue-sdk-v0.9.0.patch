+void SharedMemory::CountUploads(const std::vector<std::pair<uint32_t, uint32_t>>& page_ranges) {
+  const uint32_t page_size = uint32_t(1) << page_size_log2_;
+  if (upload_stats_hash_.empty()) {
+    upload_stats_hash_.assign(size_t(kBufferSize >> page_size_log2_), 0);
+  }
+  for (const auto& range : page_ranges) {
+    upload_stats_ranges_++;
+    for (uint32_t page = range.first; page < range.first + range.second; ++page) {
+      const uint32_t address = page << page_size_log2_;
+      if (address >= kBufferSize) break;
+      const uint8_t* data = memory_.TranslatePhysical(address);
+      // A cheap 64-bit hash of the page; never 0, which means "no upload yet".
+      uint64_t hash = 0x9E3779B97F4A7C15ull;
+      for (uint32_t i = 0; i < page_size; i += 8) {
+        uint64_t word;
+        std::memcpy(&word, data + i, 8);
+        hash = (hash ^ word) * 0x100000001B3ull;
+        hash ^= hash >> 29;
+      }
+      hash |= 1;
+      if (upload_stats_hash_[page] == hash) {
+        upload_stats_unchanged_bytes_ += page_size;
+      }
+      upload_stats_hash_[page] = hash;
+      upload_stats_bytes_ += page_size;
+      upload_stats_by_mb_[address >> 20] += page_size;
+    }
+  }
+}
+
+void SharedMemory::NoteFrameForUploadStats() {
+  if (!rex::diag::TimingLogOn()) {
+    return;
+  }
+  if (++upload_stats_frames_ < 600) {
+    return;
+  }
+  const double frames = double(upload_stats_frames_);
+  std::vector<std::pair<uint64_t, uint32_t>> regions;
+  for (uint32_t i = 0; i < uint32_t(kBufferSize >> 20); ++i) {
+    if (upload_stats_by_mb_[i]) regions.emplace_back(upload_stats_by_mb_[i], i);
+  }
+  std::sort(regions.rbegin(), regions.rend());
+  std::string by_mb;
+  for (size_t i = 0; i < regions.size() && i < 8; ++i) {
+    by_mb += fmt::format(" {:03X}xxxxx:{:.0f}KB", regions[i].second,
+                         double(regions[i].first) / 1024.0 / frames);
+  }
+  REXGPU_INFO("[timing] gpu uploads: {:.0f} KB per frame in {:.1f} ranges, {:.0f}% the same as "
+              "that page's previous upload; by physical MB per frame:{}",
+              double(upload_stats_bytes_) / 1024.0 / frames, double(upload_stats_ranges_) / frames,
+              upload_stats_bytes_
+                  ? 100.0 * double(upload_stats_unchanged_bytes_) / double(upload_stats_bytes_)
+                  : 0.0,
+              by_mb.empty() ? std::string(" none") : by_mb);
+  upload_stats_bytes_ = upload_stats_unchanged_bytes_ = upload_stats_ranges_ = 0;
+  upload_stats_frames_ = 0;
+  std::fill(std::begin(upload_stats_by_mb_), std::end(upload_stats_by_mb_), uint64_t(0));
+}
+
+bool SharedMemory::IsRangeValid(uint32_t start, uint32_t length) {
+  if (length == 0 || start >= kBufferSize) {
+    return true;
+  }
+  length = std::min(length, kBufferSize - start);
+  uint32_t page_first = start >> page_size_log2_;
+  uint32_t page_last = (start + length - 1) >> page_size_log2_;
+  uint32_t block_last = page_last >> 6;
+  auto global_lock = global_critical_region_.Acquire();
+  const uint64_t* valid_flags = active_valid_flags_.load(std::memory_order_relaxed);
+  if (!valid_flags) {
+    return true;
+  }
+  for (uint32_t i = page_first >> 6; i <= block_last; ++i) {
+    uint64_t block_valid = valid_flags[i];
+    if (i == (page_first >> 6)) {
+      block_valid |= (uint64_t(1) << (page_first & 63)) - 1;
+    }
+    if (i == block_last && (page_last & 63) != 63) {
+      block_valid |= ~((uint64_t(1) << ((page_last & 63) + 1)) - 1);
+    }
+    if (block_valid != UINT64_MAX) {
+      return false;
+    }
+  }
+  return true;
+}
