+/**
+ * ReXGlue runtime - the player identity a title sees.
+ * See rex/kernel/xam/netplay.h.
+ */
+
+#include <rex/kernel/xam/netplay.h>
+
+#include <cstdlib>
+#include <mutex>
+#include <string>
+
+#include <rex/cvar.h>
+#include <rex/platform.h>
+
+#if REX_PLATFORM_WIN32
+// NOTE: must be included last as it expects windows.h to already be included.
+#include <winsock2.h>  // NOLINT(build/include_order)
+#include <ws2tcpip.h>  // NOLINT(build/include_order)
+#else
+#include <unistd.h>
+#endif
+
+REXCVAR_DEFINE_STRING(net_player_name, "", "Network",
+                      "Name other players see in Private Match. Empty uses the Windows user "
+                      "name.");
+
+namespace rex::kernel::xam::netplay {
+namespace {
+
+void EnsureWinsock() {
+#if REX_PLATFORM_WIN32
+  static std::once_flag once;
+  std::call_once(once, [] {
+    WSADATA data;
+    WSAStartup(MAKEWORD(2, 2), &data);
+  });
+#endif
+}
+
+}  // namespace
+
+bool LiveOnline() {
+  // The title always sees a profile that can play online. That is only
+  // bookkeeping - nothing here touches the network - but a title reads it when
+  // a menu opens, and its LIVE-only screens (a leaderboard, say) only ask for
+  // data when the profile is signed in to LIVE.
+  return true;
+}
+
+uint64_t PlayerXuid(uint64_t profile_xuid) {
+  if (!profile_xuid) {
+    return profile_xuid;
+  }
+  static const uint64_t xuid = [] {
+    // Stable per PC. The seed keeps the shape the full Private Match build
+    // gives it - host | net_address | net_player_name, with an empty
+    // net_address - so a PC gets the same XUID from either build.
+    EnsureWinsock();
+    char host[256] = {};
+    gethostname(host, sizeof(host) - 1);
+    const std::string seed = std::string(host) + "|" + "" + "|" + REXCVAR_GET(net_player_name);
+    uint64_t hash = 0xCBF29CE484222325ull;  // FNV-1a
+    for (unsigned char c : seed) {
+      hash = (hash ^ c) * 0x100000001B3ull;
+    }
+    // An online-style XUID; bits 54-55 must stay clear (see UserProfile).
+    return 0x0009000000000000ull | (hash & 0x0000FFFFFFFFFFFFull);
+  }();
+  return xuid;
+}
+
+std::string PlayerName(const std::string& profile_name) {
+  return ConfiguredPlayerName(profile_name);
+}
+
+std::string ConfiguredPlayerName(const std::string& profile_name) {
+  std::string name = REXCVAR_GET(net_player_name);
+  if (name.empty()) {
+    const char* user = std::getenv("USERNAME");
+    if (!user) {
+      user = std::getenv("USER");
+    }
+    name = user ? user : "";
+  }
+  if (name.empty()) {
+    return profile_name;
+  }
+  if (name.size() > 15) {
+    name.resize(15);  // gamertag length
+  }
+  return name;
+}
+
+}  // namespace rex::kernel::xam::netplay
