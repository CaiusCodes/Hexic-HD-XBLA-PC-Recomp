+    REXLOG_INFO("gpu = {}", choice);
+    return choice;
+  }
+  const uint32_t vendor = PrimaryGpuVendorId();
+#if REX_HAS_VULKAN
+  const std::string backend = vendor == 0x10DEu ? "d3d12" : "vulkan";
+#else
+  const std::string backend = "d3d12";
+#endif
+  REXLOG_INFO("gpu = auto: GPU vendor {:04X} -> {}", vendor, backend);
+  return backend;
+}
