+            if (last_sync_qpc.QuadPart && fs.PresentCount == last_present_count + 1) {
+              const double gap = double(fs.SyncQPCTime.QuadPart - last_sync_qpc.QuadPart) * to_ms;
+              gap_max = std::max(gap_max, gap);
+              if (gap > 25.0) ++gaps;
