diff --git a/include/rex/diag_timing.h b/include/rex/diag_timing.h
new file mode 100644
index 0000000..03a10d5
--- /dev/null
+++ b/include/rex/diag_timing.h
@@ -0,0 +1,60 @@
+/**
+ * @file        rex/diag_timing.h
+ * @brief       Frame-timing diagnostics shared by the runtime and the GPU plugin.
+ *
+ * Everything here is off unless the cvar vblank_timing_log is true. It exists
+ * so a player who sees stutter can turn it on and send one log that says what
+ * the game was waiting on: slow input, SDL, file or GPU calls each get a line.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+namespace rex::diag {
+
+// vblank_timing_log, read by name (the cvar lives in the runtime, while the GPU
+// plugin is a separate DLL) and re-read at most twice a second so a hot path
+// pays one clock read and one atomic load per call.
+inline bool TimingLogOn() {
+  static std::atomic<int64_t> next_check_ms{0};
+  static std::atomic<bool> on{false};
+  const int64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                             std::chrono::steady_clock::now().time_since_epoch())
+                             .count();
+  if (now_ms >= next_check_ms.load(std::memory_order_relaxed)) {
+    next_check_ms.store(now_ms + 500, std::memory_order_relaxed);
+    on.store(rex::cvar::GetFlagByName("vblank_timing_log") == "true", std::memory_order_relaxed);
+  }
+  return on.load(std::memory_order_relaxed);
+}
+
+// Logs the enclosing call when it took at least min_ms and the log is on.
+class SlowCallTimer {
+ public:
+  SlowCallTimer(const char* what, double min_ms, uint32_t arg = 0)
+      : what_(what), min_ms_(min_ms), arg_(arg), start_(std::chrono::steady_clock::now()) {}
+  ~SlowCallTimer() {
+    const double ms =
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start_)
+            .count();
+    if (ms >= min_ms_ && TimingLogOn()) {
+      REXLOG_INFO("[timing] slow call: {}({}) {:.2f} ms", what_, arg_, ms);
+    }
+  }
+  SlowCallTimer(const SlowCallTimer&) = delete;
+  SlowCallTimer& operator=(const SlowCallTimer&) = delete;
+
+ private:
+  const char* what_;
+  double min_ms_;
+  uint32_t arg_;
+  std::chrono::steady_clock::time_point start_;
+};
+
+}  // namespace rex::diag
