+            last_sync_qpc = fs.SyncQPCTime;
+          }
+          if (last_present_count && fs.PresentCount != last_present_count) {
+            const int64_t dp = int64_t(fs.PresentCount) - int64_t(last_present_count);
+            const int64_t dr = int64_t(fs.PresentRefreshCount) - int64_t(last_refresh_count);
+            if (dp > 0 && dr >= 0 && dp < 1000 && dr < 1000) {
+              shown += uint64_t(dp);
+              refreshes += uint64_t(dr);
+              if (dr != dp) {
+                if (dr > dp) {
+                  repeats += uint64_t(dr - dp);
+                } else {
+                  drops += uint64_t(dp - dr);
+                }
