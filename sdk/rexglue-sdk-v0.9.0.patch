+uint32_t FloatToBits(float value) {
+  uint32_t bits;
+  std::memcpy(&bits, &value, sizeof(bits));
+  return bits;
+}
+
+void CaptureDrawConstants(const RegisterFile& regs, const Shader& vertex_shader,
+                          const Shader& pixel_shader) {
+  if (!draw_capture_target) {
+    draw_capture_target = REXCVAR_GET(gpu_draw_capture);
+    draw_capture_seen = 0;
+    draw_capture_counts.clear();
+  }
+  // Vertex float constants start at 0, pixel ones at 256.
+  auto vertex = [&](uint32_t c, uint32_t i) {
+    return regs[XE_GPU_REG_SHADER_CONSTANT_000_X + c * 4 + i];
+  };
+  auto pixel = [&](uint32_t c, uint32_t i) {
+    return regs[XE_GPU_REG_SHADER_CONSTANT_256_X + c * 4 + i];
+  };
+  DrawCaptureKey key{vertex_shader.ucode_data_hash(), pixel_shader.ucode_data_hash(), {}, 0, 0,
+                     0xFFFF, {}};
+  for (uint32_t c = 0; c < 256; ++c) {
+    if (vertex(c, 3) == 0xBF800000u) {  // -1.0f
+      key.neg1_reg = c;
+      for (uint32_t i = 0; i < 4; ++i) {
+        key.neg1_values[i] = vertex(c, i);
+      }
+      break;
+    }
+  }
+  for (uint32_t i = 0; i < 4; ++i) {
+    key.values[i] = pixel(4, i);
+    key.values[4 + i] = vertex(0, i);
+    key.values[8 + i] = pixel(0, i);
+    key.values[12 + i] = pixel(5, i);
+  }
+  float brightest = 0.0f;
+  for (uint32_t light = 0; light < 16; ++light) {
+    bool lit = false;
+    for (uint32_t i = 0; i < 3; ++i) {
+      const float v = BitsToFloat(pixel(22 + light, i));
+      if (v > 0.004f) lit = true;
+      brightest = std::max(brightest, v);
+    }
+    key.lights_on += lit ? 1 : 0;
+  }
+  key.light_max = FloatToBits(std::round(brightest * 100.0f) / 100.0f);
+  ++draw_capture_counts[key];
+  if (++draw_capture_seen < draw_capture_target) {
+    return;
+  }
+  std::vector<std::pair<DrawCaptureKey, uint32_t>> sorted(draw_capture_counts.begin(),
+                                                          draw_capture_counts.end());
+  std::sort(sorted.begin(), sorted.end(),
+            [](const auto& a, const auto& b) { return a.second > b.second; });
+  REXLOG_INFO("[draw_capture] {} draws, {} groups", draw_capture_seen, sorted.size());
+  auto vec4 = [](const uint32_t* v) {
+    return fmt::format("({:.3f} {:.3f} {:.3f} {:.3f})", BitsToFloat(v[0]), BitsToFloat(v[1]),
+                       BitsToFloat(v[2]), BitsToFloat(v[3]));
+  };
+  for (size_t i = 0; i < sorted.size() && i < 80; ++i) {
+    const DrawCaptureKey& k = sorted[i].first;
+    REXLOG_INFO(
+        "[draw_capture] {:5}x vs {:016X} ps {:016X} c4 {} fognf {} prim {} lparams {} "
+        "lights {} max {:.2f} neg1 {} {}",
+        sorted[i].second, k.vertex_shader, k.pixel_shader, vec4(k.values), vec4(k.values + 4),
+        vec4(k.values + 8), vec4(k.values + 12), k.lights_on, BitsToFloat(k.light_max),
+        k.neg1_reg == 0xFFFF ? std::string("none") : "c" + std::to_string(k.neg1_reg),
+        k.neg1_reg == 0xFFFF ? std::string() : vec4(k.neg1_values));
+  }
+  draw_capture_target = 0;
+  REXCVAR_SET(gpu_draw_capture, 0);
+}
