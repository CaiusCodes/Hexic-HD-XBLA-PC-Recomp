+/**
+ * @file        kernel/xam/ui_hooks.h
+ * @brief       Title-overridable hooks for otherwise-stubbed Xam system UI
+ *              calls.
+ *
+ * @copyright   Copyright (c) 2026, Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <functional>
+
+namespace rex::kernel::xam {
+
+// Some Xbox system UI entry points (achievements viewer, etc.) have no
+// equivalent on PC and are stubbed to a no-op warning by default. A title
+// app can register a callback here to run its own native UI instead (e.g. a
+// PC settings dialog) when the guest calls one of these. Registering no
+// callback preserves the original stub behavior exactly.
+//
+// Safe to call from OnPostSetup() or later, once the runtime/kernel and an
+// ImGuiDrawer are available.
+void SetShowAchievementsUICallback(std::function<void()> callback);
+
+}  // namespace rex::kernel::xam
