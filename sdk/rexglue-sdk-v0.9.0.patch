+                          "late frames (over 6 ms later than usual){}{}; longest gap between "
+                          "frames on screen {:.1f} ms ({} over 25 ms)",
+                          latency_sum / double(latency_n), latency_max, late, late ? " at" : "",
+                          late > 6 ? late_times + " ..." : late_times, gap_max, gaps);
+            }
+            window_start = now;
+            refreshes = shown = repeats = drops = events = 0;
+            event_times.clear();
+            latency_n = late = gaps = 0;
+            latency_sum = latency_max = gap_max = 0.0;
+            late_times.clear();
+          }
+        }
+      }
+      if (prev.QuadPart) {
+        const double ms = double(now.QuadPart - prev.QuadPart) * 1000.0 / double(freq.QuadPart);
+        ++count;
+        sum += ms;
+        sq += ms * ms;
+        mx = std::max(mx, ms);
+      } else {
+        start = now;
+      }
+      prev = now;
+      if (double(now.QuadPart - start.QuadPart) >= 10.0 * double(freq.QuadPart) && count) {
+        const double mean = sum / double(count);
