+// A TOML basic string: every backslash and quote has to be escaped, or the
+// file will not parse. Windows paths are the common case - one unescaped
+// "C:\Users\..." makes the whole config invalid, and every setting in it is
+// lost the next time the game starts.
+std::string EscapeTOMLString(const std::string& value) {
+  std::string out;
+  out.reserve(value.size() + 8);
+  for (const char c : value) {
+    switch (c) {
+      case '\\':
+        out += "\\\\";
+        break;
+      case '"':
+        out += "\\\"";
+        break;
+      case '\n':
+        out += "\\n";
+        break;
+      case '\r':
+        out += "\\r";
+        break;
+      case '\t':
+        out += "\\t";
+        break;
+      default:
+        out += c;
+        break;
+    }
+  }
+  return out;
+}
