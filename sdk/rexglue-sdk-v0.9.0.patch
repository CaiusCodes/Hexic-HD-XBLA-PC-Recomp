+/**
+ * ReXGlue runtime - the player identity a title sees.
+ *
+ * Titles ask the kernel who is playing: an XUID, a gamertag and whether the
+ * profile is signed in to Xbox LIVE. This header answers those questions
+ * without any Xbox LIVE service. It is a strict subset of the fuller header
+ * the Perfect Dark port uses, which adds Private Match networking (LAN,
+ * Direct Connect and the relay) under the same namespace, so a title written
+ * against this one builds against either.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace rex::kernel::xam::netplay {
+
+// The title should see a signed-in, connected LIVE profile with multiplayer
+// privileges. That is only bookkeeping: nothing here touches the network.
+bool LiveOnline();
+
+// The XUID the title sees. Each PC gets its own stable, online-style XUID;
+// saves keep using the profile's own XUID. A zero (no profile) stays zero.
+uint64_t PlayerXuid(uint64_t profile_xuid);
+
+// The gamertag the title sees: net_player_name, else the Windows user name,
+// else the profile's own name; at most 15 characters.
+std::string PlayerName(const std::string& profile_name);
+
+// Same name, for a settings screen to show.
+std::string ConfiguredPlayerName(const std::string& profile_name);
+
+}  // namespace rex::kernel::xam::netplay
