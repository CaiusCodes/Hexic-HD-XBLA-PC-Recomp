+        count = 0;
+        sum = sq = mx = 0.0;
+      }
+    } else {
+      prev.QuadPart = 0;
+    }
+  }
   // Even if presentation has failed, work might have been enqueued anyway
   // internally before the failure according to Jesse Natalie from the DirectX
   // Discord server.
